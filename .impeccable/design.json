  "narrative": {
    "northStar": "Colourful art-room workbook",
    "overview": "The Painting Room uses the confirmed colourful art-room workbook direction: personable display lettering, warm paper, vivid chapter fields and calm reading columns. It supports reading, making notes and printing classroom sheets. Real artworks retain their natural proportions and visible attribution.\n\nColour indexes levels and distinguishes useful teaching furniture; long task prose stays on paper. Standard numbers remain conspicuous throughout the ordinary link navigation. The same language carries the library, level introductions, task sheets, artist directory and teacher guidance.",
    "keyCharacteristics": [
      "Warm paper and ink, with fuchsia identity and three chapter themes.",
      "Large Bricolage headings paired with readable DM Sans.",
      "Flat, ruled document surfaces and compact native controls.",
      "Numbered standards, numbered studio steps and a locally saved evidence checklist.",
      "Print-specific type, spacing and source addresses."
    ],
    "rules": [
      {
        "name": "The Chapter Index Rule",
        "body": "Use cobalt for Level 1, deep orange for Level 2 and fuchsia for Level 3 task headings, reference numbers and pale chapter fields. The home chapter strip is its own existing treatment: cobalt-blue, yellow and raspberry. Do not infer a yellow Level 2 task theme from that strip.",
        "section": "colors"
      },
      {
        "name": "The Reading Column Rule",
        "body": "Keep task prose within the established 70ch reading width on wide screens. Collapse the navigation rail above the reading column on narrow screens.",
        "section": "typography"
      },
      {
        "name": "The Flat Workbook Rule",
        "body": "Use paper colour, one-pixel rules and spacing to separate content. The shipped system has no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the established chapter theme for numbered standards and teaching accents.",
      "Do preserve native links, labelled form controls and the visible keyboard focus outline.",
      "Do show artwork at its natural aspect ratio with an artist, title and source/rights caption.",
      "Do retain the checklist count, browser-storage feedback and clear action when extending saved working notes.",
      "Do check print styles when extending a task sheet; source URLs and readable evidence rows must survive."
    ],
    "donts": [
      "Don't spread chapter colour over the long reading prose.",
      "Don't replace standard numbers with decorative identifiers.",
      "Don't add shadows or rounded card shells to ordinary document sections.",
      "Don't imply that completing an evidence checklist guarantees a grade or submits evidence."
    ]
  }
}
